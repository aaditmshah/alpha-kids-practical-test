# Copy this file to .env.local and fill in your own values. .env.local is gitignored.

# A free Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Free-tier prompts may be used by Google to improve its products, so only try made-up concerns.
GOOGLE_GENERATIVE_AI_API_KEY=

# The Gemini model the coach uses. Optional; this is the default.
COACH_MODEL=gemini-3.8-flash
