{
	// The wiki repeats each page's frontmatter `title` as its H1: the frontmatter is for agents, and
	// the H1 is the prominent title humans see in VS Code and on GitHub. MD025 would otherwise count
	// the frontmatter title as a second H1. The wiki linter checks that the two match
	// (wiki/adr-0009-title-in-frontmatter-and-h1.md).
	"MD025": { "front_matter_title": "" },
}
