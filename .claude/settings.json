{
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Read(./.env.local)",
			"Read(./.env.*.local)",
			"Read(./.env.development)",
			"Read(./.env.production)",
			"Read(./.env.test)",
			"Edit(./.env)",
			"Edit(./.env.local)",
			"Edit(./.env.*.local)",
			"Edit(./.env.development)",
			"Edit(./.env.production)",
			"Edit(./.env.test)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-env.ts\"",
						"timeout": 10
					}
				]
			}
		]
	}
}
