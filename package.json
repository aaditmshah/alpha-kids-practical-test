{
	"name": "alpha-kids-practical-test",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": [
			"./src/*"
		]
	},
	"scripts": {
		"build": "next build",
		"dev": "next dev",
		"githooks:install": "git config core.hooksPath .githooks",
		"pr:wiki-page": "node scripts/check-pr-wiki-page.ts",
		"start": "next start",
		"typegen": "next typegen",
		"wiki:lint": "node .claude/skills/wiki-maintain/scripts/lint.ts wiki"
	},
	"dependencies": {
		"next": "16.4.6",
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/turbopack": "4.3.3",
		"@types/node": "^26.5.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"babel-plugin-react-compiler": "1.0.0",
		"gitmoji-cli": "^9.7.0",
		"tailwindcss": "4.3.3",
		"typescript": "^5",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "26.13.0"
	},
	"gitmoji": {
		"autoAdd": false,
		"emojiFormat": "emoji",
		"scopePrompt": false,
		"messagePrompt": true,
		"capitalizeTitle": true,
		"gitmojisUrl": "https://gitmoji.dev/api/gitmojis"
	}
}
